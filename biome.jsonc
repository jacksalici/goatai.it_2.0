{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // SVG files are static assets, not source code.
    "includes": ["**", "!**/*.svg"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 88
  },
  "css": {
    "parser": {
      // Tailwind v4 syntax: @theme, @utility, @variant, @apply…
      "tailwindDirectives": true
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "style": {
        // `!` is the house style for refs read in effects and for getContext("2d").
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      // Biome treats <canvas> as focusable; these canvases are decorative.
      "includes": ["src/components/dot-field.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noAriaHiddenOnFocusable": "off"
          }
        }
      }
    }
  ]
}
